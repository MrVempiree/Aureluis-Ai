# ── Aureluis-Ai environment configuration ─────────────────────────────────────
# Copy this file to `.env` and fill in your own values. Never commit `.env`.
# Every value below is a placeholder — no real credentials are stored here.

# Required — Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Required for administrator access — comma-separated numeric Telegram user IDs
# Example: ADMIN_IDS=123456789,987654321
ADMIN_IDS=your_telegram_numeric_user_id_here

# Optional AI providers — at least one is required for the bot to answer.
# Provider fallback order: Gemini -> Groq -> OpenRouter

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Groq
GROQ_API_KEY=your_groq_api_key_here

# OpenRouter (uses the OpenAI-compatible SDK)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Required — HTTP port the API server listens on
PORT=8080

# Optional — runtime environment
NODE_ENV=production
